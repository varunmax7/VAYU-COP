DATABASE_URL=sqlite:///./vayu.db
# For Postgres via docker compose, use:
# DATABASE_URL=postgresql+psycopg://vayu:vayu@localhost:5432/vayu

JWT_SECRET=change-me
JWT_EXPIRE_MIN=720

WEATHER_MODE=auto            # auto | live | synthetic
MAP_TILES=auto               # auto | online | offline
LLM_PROVIDER=none            # none | anthropic | openai | ollama
LLM_MODEL=
LLM_API_KEY=
OLLAMA_URL=http://localhost:11434

SIM_AUTOSTART=false
SIM_SPEED=10

CORS_ORIGINS=http://localhost:5173
