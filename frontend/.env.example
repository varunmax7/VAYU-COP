# Vite only exposes vars prefixed VITE_ to client code — copy this to .env.local to override.

# auto | online | offline — mirrors the backend's MAP_TILES (§13.4). The map fetches
# CARTO tiles directly in the browser, so this is a separate frontend-only setting;
# "auto" also falls back to offline rendering automatically after repeated tile errors.
VITE_MAP_TILES=auto
